# 统一换行符：仓库内一律 LF，检出时按平台自动转换
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary

# 让 git diff 把 HTML/CSS/JS 当文本处理
*.html text
*.css  text
*.js   text
*.json text
*.md   text
